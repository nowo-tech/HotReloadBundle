{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), { title: 'Demo login' }) }}
{% endblock %}

{% block body %}
    <div class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {% if error %}
                <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {{ form_start(loginForm) }}
                {% for child in loginForm %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(loginForm) }}

            <p class="nowo-ui-muted">Try <code class="nowo-ui-code">debugger / debug</code> or <code class="nowo-ui-code">viewer / viewer</code>.</p>
        </div>
    </div>
{% endblock %}

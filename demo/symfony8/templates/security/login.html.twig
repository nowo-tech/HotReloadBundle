{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Demo login',
        intro: 'Try debugger / debug or viewer / viewer (local demos only).',
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: error ? {error: [error.messageKey|trans(error.messageData, 'security')]} : null}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Sign in', kind: 'form'} %}
        {% block section_body %}
            {{ form_start(loginForm, {attr: {id: 'demo-login-form'}}) }}
                {% for child in loginForm %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(loginForm, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('homepage') }}">Back to home</a>
            <button type="submit" form="demo-login-form" class="nowo-ui-btn nowo-ui-btn--primary">Sign in</button>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Hot Reload · Home{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">FrankenPHP Hot Reload demo</h1>
        <p class="lead">This Symfony app uses <strong>Nowo HotReloadBundle</strong> to inject the Dunglas/FrankenPHP hot-reload client when <code>FRANKENPHP_HOT_RELOAD</code> is set by the server.</p>

        <div class="alert alert-secondary">
            <div><strong>Rendered at:</strong> <code>{{ generatedAt }}</code></div>
            <div class="mt-2">
                <strong>FRANKENPHP_HOT_RELOAD:</strong>
                {% if frankenphpHotReload %}
                    <code>{{ frankenphpHotReload }}</code>
                {% else %}
                    <span class="text-warning">not set</span> (assets will not inject until Mercure + <code>hot_reload</code> are enabled in Caddy)
                {% endif %}
            </div>
        </div>

        <p>
            <a class="btn btn-primary" href="{{ path('demo_live') }}">Open live page</a>
        </p>

        <h2 class="h5 mt-4">Try it</h2>
        <ol>
            <li>Ensure the demo Caddyfile has <code>mercure</code> + <code>hot_reload</code> (and <code>worker.watch</code> in worker mode).</li>
            <li>Open the live page.</li>
            <li>Edit <code>templates/demo/live.html.twig</code> and save — the browser should morph/reload.</li>
        </ol>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Hot Reload · Live{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), { title: 'Live page', intro: hint }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <p class="nowo-ui-muted">Server render timestamp</p>
            <p><code class="nowo-ui-code" id="generated-at">{{ generatedAt }}</code></p>
        </div>
    </section>
    <p class="nowo-ui-muted">
        View source / DevTools: look for <code class="nowo-ui-code">data-nowo-hot-reload</code> and the <code class="nowo-ui-code">frankenphp-hot-reload:url</code> meta tag.
    </p>
{% endblock %}

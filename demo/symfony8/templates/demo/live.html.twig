{% extends 'base.html.twig' %}

{% block title %}Hot Reload · Live{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), { title: 'Live page', intro: hint }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Server render timestamp', intro: 'View source / DevTools: look for data-nowo-hot-reload and the frankenphp-hot-reload:url meta tag.', kind: 'detail'} %}
        {% block section_body %}
            <p><code class="nowo-ui-code" id="generated-at">{{ generatedAt }}</code></p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Hot Reload · Live{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Live page</h1>
        <p>{{ hint }}</p>
        <div class="p-4 border rounded bg-light">
            <p class="mb-1 text-secondary small">Server render timestamp</p>
            <p class="display-6 mb-0"><code id="generated-at">{{ generatedAt }}</code></p>
        </div>
        <p class="mt-3 text-secondary small">
            View source / DevTools: look for <code>data-nowo-hot-reload</code> and the <code>frankenphp-hot-reload:url</code> meta tag.
        </p>
    </div>
</div>
{% endblock %}

{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The password-toggle stylesheet is the PasswordToggle bundle's own. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Hot Reload Demo{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowopasswordtoggle/css/toggle_password.css') }}">
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('homepage') }}">Hot Reload Bundle</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('homepage') }}"{% if _route == 'homepage' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="{{ path('demo_live') }}"{% if _route == 'demo_live' %} aria-current="page"{% endif %}>Live page</a>
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
{% endblock %}

{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo.
    The password-toggle stylesheet is the PasswordToggle bundle's own. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Hot Reload',
    home_route: 'homepage',
    repository: 'https://github.com/nowo-tech/HotReloadBundle',
    translation_domain: false,
    auth: {login_route: 'login', logout_route: 'logout'},
    nav: [
        {label: 'Home', route: 'homepage', section: 'Hot Reload'},
        {label: 'Live page', route: 'demo_live', section: 'Hot Reload'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Hot Reload Demo{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowopasswordtoggle/css/toggle_password.css') }}">
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
{% endblock %}

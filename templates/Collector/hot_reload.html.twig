{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set status = collector.status %}
    {% set status_color = status == 'active' ? 'green' : (status == 'ready' ? 'yellow' : (collector.diagnosticStatus == 'fail' ? 'red' : '')) %}
    {% set status_label = {
        'active': 'on',
        'ready': 'ready',
        'idle': 'idle',
        'disabled': 'off'
    }[status]|default(status) %}

    {% set icon %}
        <span class="icon">{{ source('@NowoHotReloadBundle/Icon/hot-reload.svg') }}</span>
        <span class="sf-toolbar-value">{{ status_label }}</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Status</b>
            <span>{{ status }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Injected</b>
            <span>{{ collector.injected ? 'yes' : 'no' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Should render</b>
            <span>{{ collector.shouldRender ? 'yes' : 'no' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Auto-inject</b>
            <span>{{ collector.autoInject ? 'yes' : 'no' }}</span>
        </div>
        {% if collector.mercureUrl %}
            <div class="sf-toolbar-info-piece">
                <b>Mercure</b>
                <span
                    class="sf-toolbar-status sf-toolbar-status-{{ collector.injected ? 'green' : 'normal' }}"
                    title="{{ collector.mercureUrl }}"
                    style="display:inline-block;max-width:16rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;"
                >{{ collector.mercureUrlShort }}</span>
            </div>
        {% endif %}
        <div class="sf-toolbar-info-piece">
            <b>Idiomorph</b>
            <span>{{ collector.idiomorph ? 'on' : 'off' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Checks</b>
            <span
                class="sf-toolbar-status sf-toolbar-status-{{ collector.diagnosticStatus == 'fail' ? 'red' : (collector.diagnosticStatus == 'warn' ? 'yellow' : 'green') }}"
                title="{{ collector.diagnosticSummary }}"
                style="display:inline-block;max-width:16rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;"
            >{{ collector.diagnosticSummary }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: true, status: status_color }) }}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.status == 'active' and collector.diagnosticStatus != 'fail' ? '' : ' disabled' }}">
        <span class="icon">{{ source('@NowoHotReloadBundle/Icon/hot-reload.svg') }}</span>
        <strong>Hot Reload</strong>
        <span class="count">
            <span>{{ collector.status }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <h2>FrankenPHP Hot Reload</h2>
    <p>
        Dev-only client injection for
        <a href="https://frankenphp.dev/docs/hot-reload/" rel="noopener noreferrer" target="_blank">FrankenPHP Hot Reload</a>
        via <code>nowo-tech/hot-reload-bundle</code>.
    </p>

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.status }}</span>
            <span class="label">Status</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.injected ? 'yes' : 'no' }}</span>
            <span class="label">Injected this request</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.shouldRender ? 'yes' : 'no' }}</span>
            <span class="label">Render gate open</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.diagnosticStatus }}</span>
            <span class="label">Checks</span>
        </div>
    </div>

    <h3>Environment checks</h3>
    <p class="help">{{ collector.diagnosticSummary }}{% if collector.environment %} · kernel.environment=<code>{{ collector.environment }}</code>{% endif %}</p>
    {% if collector.actionableChecks is not empty %}
        <div class="empty">
            <p><strong>What is missing / what to do</strong></p>
            <ul>
                {% for check in collector.actionableChecks %}
                    <li>
                        <span class="label status-{{ check.status == 'fail' ? 'error' : 'warning' }}">{{ check.status }}</span>
                        <strong>{{ check.label }}</strong>
                        — {{ check.fix|default(check.detail) }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    <table>
        <thead>
            <tr>
                <th>Status</th>
                <th>Check</th>
                <th>Detail</th>
                <th>What to do</th>
            </tr>
        </thead>
        <tbody>
            {% for check in collector.checks %}
                <tr>
                    <td>
                        {% set check_status_class = {
                            'pass': 'success',
                            'fail': 'error',
                            'warn': 'warning',
                            'info': '',
                            'skip': ''
                        }[check.status]|default('') %}
                        <span class="label{{ check_status_class ? ' status-' ~ check_status_class : '' }}">{{ check.status }}</span>
                    </td>
                    <th>{{ check.label }}</th>
                    <td class="nowo-hr-break">{{ check.detail }}</td>
                    <td>
                        {% if check.fix %}
                            {{ check.fix }}
                        {% else %}
                            <em>—</em>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4"><em>No checks recorded for this profile.</em></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3>Runtime</h3>
    <style>
        .nowo-hr-break { overflow-wrap: anywhere; word-break: break-all; }
    </style>
    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th>kernel.environment</th>
                <td>{{ collector.environment|default('—') }}</td>
            </tr>
            <tr>
                <th>enabled</th>
                <td>{{ collector.enabled ? 'true' : 'false' }}</td>
            </tr>
            <tr>
                <th>auto_inject</th>
                <td>{{ collector.autoInject ? 'true' : 'false' }}</td>
            </tr>
            <tr>
                <th>require_frankenphp_env</th>
                <td>{{ collector.requireFrankenphpEnv ? 'true' : 'false' }}</td>
            </tr>
            <tr>
                <th>FRANKENPHP_HOT_RELOAD</th>
                <td class="nowo-hr-break"><code title="{{ collector.frankenphpHotReloadEnv|default('') }}">{{ collector.frankenphpHotReloadEnv|default('—') }}</code></td>
            </tr>
            <tr>
                <th>Resolved Mercure URL</th>
                <td class="nowo-hr-break"><code title="{{ collector.mercureUrl|default('') }}">{{ collector.mercureUrl|default('—') }}</code></td>
            </tr>
        </tbody>
    </table>

    <h3>Client assets</h3>
    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th>idiomorph</th>
                <td>{{ collector.idiomorph ? 'true' : 'false' }}</td>
            </tr>
            <tr>
                <th>idiomorph_script_url</th>
                <td class="nowo-hr-break"><code>{{ collector.idiomorphScriptUrl }}</code></td>
            </tr>
            <tr>
                <th>hot_reload_script_url</th>
                <td class="nowo-hr-break"><code>{{ collector.hotReloadScriptUrl }}</code></td>
            </tr>
            <tr>
                <th>preserve_observe</th>
                <td>{{ collector.preserveObserve ? 'true' : 'false' }}</td>
            </tr>
            <tr>
                <th>preserve_selectors</th>
                <td>
                    {% if collector.preserveSelectors is empty %}
                        <em>none</em>
                    {% else %}
                        <ul>
                            {% for selector in collector.preserveSelectors %}
                                <li><code>{{ selector }}</code></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <h3>CSP</h3>
    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th>csp_nonce_request_attribute</th>
                <td>{{ collector.cspNonceRequestAttribute|default('—') }}</td>
            </tr>
            <tr>
                <th>csp_augment_script_src</th>
                <td>{{ collector.cspAugmentScriptSrc ? 'true' : 'false' }}</td>
            </tr>
            <tr>
                <th>csp_script_src_hosts</th>
                <td>
                    {% if collector.cspScriptSrcHosts is empty %}
                        <em>derive from script URLs</em>
                    {% else %}
                        <ul>
                            {% for host in collector.cspScriptSrcHosts %}
                                <li><code>{{ host }}</code></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <p class="help">
        CLI equivalent: <code>php bin/console nowo:hot-reload:check</code>.
        Caddy / FrankenPHP setup: <code>docs/ENVIRONMENT.md</code>.
        Also <code>docs/CSP.md</code> and <code>docs/USAGE.md</code>.
    </p>
{% endblock %}
